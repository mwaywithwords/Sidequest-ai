# Public. NEXT_PUBLIC_* values are inlined into the browser bundle at build
# time, so treat both of these as visible to anyone using the app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never read these outside a module that imports "server-only".
# SUPABASE_SECRET_KEY bypasses Row Level Security.
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
